# Copy to .env (git-ignored) and adjust. Every value here is a local
# development default; never reuse them outside your machine.

# PostgreSQL (docker-compose: postgres, transaction-service)
DB_USERNAME=finflow
DB_PASSWORD=finflow

# Keycloak bootstrap admin (docker-compose: keycloak)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me

# Stripe test mode (docker-compose: transaction-service). Take both from the
# Stripe dashboard / CLI: sk_test_... and whsec_... Never use live keys here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Host port of the API gateway (docker-compose: api-gateway). Change it if
# 8080 is already taken on your machine.
GATEWAY_PORT=8080

# Host port of Grafana (docker-compose: grafana), bound to localhost only.
GRAFANA_PORT=3000

# Host port of Prometheus (docker-compose: prometheus), bound to localhost only.
PROMETHEUS_PORT=9090

# Host port of Alertmanager (docker-compose: alertmanager), bound to localhost only.
ALERTMANAGER_PORT=9093
